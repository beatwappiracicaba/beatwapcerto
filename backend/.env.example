JWT_SECRET=
EMAIL_CODE_SECRET=
ANALYTICS_SALT=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
APP_PUBLIC_URL=

# Envio de email (convites, codigo de verificacao, redefinicao de senha)
# Sem SMTP_USER/SMTP_PASS o envio de email e desativado e a API responde
# com erro explicito em vez de fingir sucesso.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# remetente padrao; padrao = SMTP_USER
SMTP_FROM=
# true registra o trafego SMTP no console
SMTP_DEBUG=false
# validade do convite, em horas
INVITE_TTL_HOURS=24
