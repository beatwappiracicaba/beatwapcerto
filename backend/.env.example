JWT_SECRET=
EMAIL_CODE_SECRET=
ANALYTICS_SALT=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
APP_PUBLIC_URL=

# Envio de email (convites, codigo de verificacao, redefinicao de senha)
# Sem BREVO_API_KEY e sem SMTP_USER/SMTP_PASS o envio fica desativado e a API
# responde com erro explicito em vez de fingir sucesso.
#
# A API HTTPS tem preferencia porque muitos VPS bloqueiam as portas SMTP
# (587/465/25). A chave e do tipo "xkeysib-...", criada em
# https://app.brevo.com/settings/keys/api (a chave "xsmtpsib-..." e so SMTP).
# O remetente precisa estar verificado no painel do Brevo.
BREVO_API_KEY=
SMTP_FROM=
SMTP_FROM_NAME=BeatWap
# fallback SMTP, usado apenas se BREVO_API_KEY estiver vazio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true registra o trafego SMTP no console
SMTP_DEBUG=false
# validade do convite, em horas
INVITE_TTL_HOURS=24
